{
  "name": "slippy-fingers",
  "version": "1.0.0",
  "description": "Touch-typing trainer with real-time keyboard visualization — Slippy Fingers edition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write 'src/**/*.{js,html,css}'",
    "format:check": "prettier --check 'src/**/*.{js,html,css}'"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2"
  },
  "keywords": [
    "typing",
    "trainer",
    "keyboard",
    "touch-typing",
    "pwa",
    "web"
  ],
  "author": "Slippy Fingers Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/go-pato/slippy-fingers.git"
  }
}
